# Flaming Horse Environment Configuration
# Copy this file to .env and adjust local paths as needed.

# Local Grok Build CLI harness backend.
GROK_MODEL=grok-build
# Optional: set when `grok` is not on PATH.
# GROK_CLI=/absolute/path/to/grok
# Optional: seconds to wait for each harness phase.
# GROK_CLI_TIMEOUT_SECONDS=900

# ============================================
# Other config (unchanged)
# ============================================
USE_HARNESS=1

# Voice TTS backend
FLAMING_HORSE_TTS_BACKEND=mlx
# Required when FLAMING_HORSE_TTS_BACKEND=mlx:
FLAMING_HORSE_MLX_PYTHON=/absolute/path/to/python-with-mlx-audio
FLAMING_HORSE_MLX_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
# Required when FLAMING_HORSE_TTS_BACKEND=qwen:
# FLAMING_HORSE_QWEN_PYTHON=/absolute/path/to/python-with-qwen-tts
# Optional project creation override; default remains media/voiceovers/qwen.
# FLAMING_HORSE_TTS_OUTPUT_DIR=media/voiceovers/qwen

# Voice reference directory (optional - overrides voice_clone_config.json)
# Set to switch between reference samples easily, e.g.:
#   FLAMING_HORSE_VOICE_REF_DIR=/absolute/path/to/assets/voice_ref
#   FLAMING_HORSE_VOICE_REF_DIR=/absolute/path/to/assets/voice_ref_2

# Offline mode for HuggingFace
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# Parallel rendering (0=auto, N=use N jobs, -1=disable)
PARALLEL_RENDERS=0
